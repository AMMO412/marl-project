<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.5">
  <model name="heightmap">
    <static>true</static>
    <link name="link">
      <collision name="collision_yosemite">
        <geometry>
          <heightmap>
            <uri>model://yosemite/media/yosemite_elevation.png</uri>
            <size>280 280 90</size>
            <pos>0 0 -10</pos>
          </heightmap>
        </geometry>
      </collision>
      <visual name="visual_yosemite">
        <geometry>
          <heightmap>
            <texture>
              <diffuse>model://yosemite/media/textures/yosemite_color.png</diffuse>
              <size>280</size>
            </texture>
            <uri>model://yosemite/media/yosemite_elevation.png</uri>
            <size>280 280 90</size>
            <pos>0 0 -10</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
